# Maintainer: FAZuH <mail@fazuh.com>
#
# Builds this fork from source. The AUR's omarchy-meeting-recorder-bin ships
# upstream's binary and conflicts with this package, so the fork is packaged
# under its own name.

pkgname=omarchy-meeting-recorder
pkgver=1.8.0
pkgrel=1
pkgdesc="Meeting Recorder for Omarchy: record the mic and the computer audio, transcribed on your own machine with speakers, chapters and a player"
arch=('x86_64')
url="https://github.com/FAZuH/omarchy-meeting-recorder"
license=('MIT')
depends=('gtk4' 'libadwaita' 'glib2' 'pango' 'cairo' 'graphene' 'libgcc' 'libstdc++' 'glibc' 'libpulse' 'ffmpeg' 'vulkan-icd-loader')
optdepends=('quickshell: the bar widget, part of every Omarchy install'
            'perl-file-mimeinfo: open .meeting-recorder files with xdg-open, not only from Nautilus')
conflicts=('omarchy-meeting-recorder-bin')
options=('!debug')
source=("omarchy-meeting-recorder-$pkgver.tar.gz")
sha256sums=('b7f78334dc04ef1988ae45056b4a8ebcd1b5bba31e358734177f168f90f98fc8')

build() {
  cd "$srcdir/omarchy-meeting-recorder-$pkgver"
  # Reuse the checkout's target dir so the dependency artifacts are not rebuilt.
  CARGO_TARGET_DIR="$HOME/Projects/omarchy/omarchy-meeting-recorder/target" \
    cargo build --release --locked
}

package() {
  cd "$srcdir/omarchy-meeting-recorder-$pkgver"
  local target="$HOME/Projects/omarchy/omarchy-meeting-recorder/target"
  install -Dm755 "$target/release/omarchy-meeting-recorder" "$pkgdir/usr/bin/omarchy-meeting-recorder"
  install -Dm644 "data/omarchy-meeting-recorder.desktop" "$pkgdir/usr/share/applications/omarchy-meeting-recorder.desktop"
  install -Dm644 "data/omarchy-meeting-recorder.xml" "$pkgdir/usr/share/mime/packages/omarchy-meeting-recorder.xml"
  # The bar widget, linked into ~/.config/omarchy/plugins by the installer.
  install -Dm644 "plugin/manifest.json" "$pkgdir/usr/share/omarchy-meeting-recorder/plugin/manifest.json"
  install -Dm644 "plugin/Widget.qml" "$pkgdir/usr/share/omarchy-meeting-recorder/plugin/Widget.qml"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm755 -t "$pkgdir/usr/share/doc/$pkgname/examples/actions" examples/actions/*
}
